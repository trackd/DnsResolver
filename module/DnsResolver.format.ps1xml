<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>DnsRecord</Name>
      <ViewSelectedBy>
        <TypeName>DnsResolver.DnsRecord</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>Name</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Type</Label>
            <Width>5</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>TTL</Label>
            <Width>7</Width>
            <Alignment>Right</Alignment>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Data</Label>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <PropertyName>Name</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Type</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  if ($_.Ttl.TotalDays -ge 1) {
                      '{0:0}d{1:0}h' -f $_.Ttl.TotalDays, $_.Ttl.Hours
                  }
                  elseif ($_.Ttl.TotalHours -ge 1) {
                      '{0:0}h{1:0}m' -f $_.Ttl.TotalHours, $_.Ttl.Minutes
                  }
                  elseif ($_.Ttl.TotalMinutes -ge 1) {
                      # greater than 1 minute
                      '{0:0}m' -f $_.Ttl.TotalMinutes
                  }
                  else {
                      # less than 1 minute
                      '{0:0}s' -f $_.Ttl.TotalSeconds
                  }
                </ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Data</PropertyName>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
